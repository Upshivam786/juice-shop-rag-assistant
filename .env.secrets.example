# Copy this to .env.secrets (which should be in .gitignore) and fill in real values.
# Referenced by docker-compose.rag.yml via `env_file: [.env.secrets]`.

OPENROUTER_API_KEY=sk-or-v1-your-real-key-here

# Required for POST /assistant/ingest to be protected. Generate any long
# random string, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=change-me-to-a-random-secret
